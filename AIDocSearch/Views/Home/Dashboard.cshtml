@*
    Futuristic Dashboard with Hero Search and Glassmorphism Cards
*@
@{
    ViewData["Title"] = "Dashboard";
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest";
}

<link href="~/css/search.css" rel="stylesheet" />
<link href="~/css/dashboard.css" rel="stylesheet" />

<!-- Hero Section with Centered Search -->
<div class="fut-hero">
    <div class="fut-hero-content">
        <!-- Logo -->
        <img src="~/images/logo.webp"
             alt="Indian Army IntelliSearch Logo"
             class="fut-logo" />

        <!-- Title -->
        <h1 class="fut-title">
            Indian Army IntelliSearch
        </h1>

        <!-- Subtitle -->
        <h2 class="fut-subtitle">
            Your Smart Document Exploration and Search Engine
        </h2>

        <!-- Search Form -->
        <form id="searchForm"
              method="post"
              action="~/Search/Index"
              class="fut-search-form"
              role="search">

            <div class="fut-search-wrapper">
                <img src="~/images/Search.png"
                     alt=""
                     class="fut-search-icon"
                     aria-hidden="true" />

                <input type="text"
                       id="searchInput"
                       name="searchInput"
                       class="fut-search-input"
                       placeholder="Search documents, keywords, topics..."
                       aria-label="Search"
                       autofocus
                       autocomplete="off" />

                <button id="searchBtn"
                        class="fut-search-btn"
                        type="submit">
                    <i class="fas fa-search" aria-hidden="true"></i> Search
                </button>
            </div>

            <div id="suggestions"></div>
            <span class="msgerror alert alert-danger d-none"></span>
        </form>
    </div>

    <!-- Cards Section -->
    <div class="fut-cards-section">
        <div class="fut-cards-row">

            <!-- Card 1: Quick Stats -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="fut-card-title">Quick Stats</h3>
                <p class="fut-card-text">
                    Access powerful analytics and insights from your document repository.
                </p>
                <ul class="fut-card-list">
                    <li><i class="fas fa-file-alt"></i> Total Documents: Loading...</li>
                    <li><i class="fas fa-search"></i> Recent Searches: Loading...</li>
                    <li><i class="fas fa-database"></i> Index Status: Active</li>
                </ul>
            </div>

            <!-- Card 2: Recent Activity -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-history"></i>
                </div>
                <h3 class="fut-card-title">Recent Activity</h3>
                <p class="fut-card-text">
                    Track your latest searches and document interactions.
                </p>
                <ul class="fut-card-list">
                    <li><i class="fas fa-clock"></i> Last search: Today</li>
                    <li><i class="fas fa-upload"></i> Last upload: Yesterday</li>
                    <li><i class="fas fa-eye"></i> Most viewed: Documents</li>
                </ul>
            </div>

            <!-- Card 3: Quick Tips -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3 class="fut-card-title">Quick Tips</h3>
                <p class="fut-card-text">
                    Enhance your search experience with these pro tips.
                </p>
                <ul class="fut-card-list">
                    <li><i class="fas fa-keyboard"></i> Press <kbd>/</kbd> to focus search</li>
                    <li><i class="fas fa-quote-left"></i> Use quotes for exact phrases</li>
                    <li><i class="fas fa-filter"></i> Apply filters for precision</li>
                </ul>
            </div>

        </div>
    </div>

</div>


