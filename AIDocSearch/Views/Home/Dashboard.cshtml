@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="~/css/search.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<main class="intel-dashboard">

    <!-- Main Hero -->
    <section class="intel-hero">

        <div class="intel-hero-inner">

            <!-- Brand Identity -->
            <div class="intel-brand">

                @* <div class="intel-logo-box">
                    <img src="~/images/logo.png"
                         alt="Indian Army IntelliSearch"
                         class="fut-logo intel-logo" />
                </div> *@

                <div class="intel-brand-content">
                    <div class="intel-eyebrow">
                        <span class="intel-status-dot"></span>
                        INTELLIGENT DOCUMENT DISCOVERY
                    </div>

                    <h1>Indian Army <span>IntelliSearch</span></h1>

                    <p>
                        Search, explore and discover knowledge
                        across documents and indexed web sources.
                    </p>
                </div>

            </div>

            <!-- Search -->
            <form id="searchForm"
                  method="post"
                  action="@Url.Action("Index", "Search")"
                  class="fut-search-form"
                  role="search">

                <div class="fut-search-container">

                    <div class="fut-search-wrapper">

                      
                        <button type="button"
                                class="fut-upload-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#uploadPdfModal"
                                title="Upload PDF to Searchable Index"
                                aria-label="Upload PDF">

                            <i class="fa-solid fa-plus"></i>

                        </button>

                        <input type="text"
                               id="searchInput"
                               name="searchInput"
                               class="fut-search-input"
                               placeholder="Search documents, keywords, phrases or related topics..."
                               aria-label="Search Documents"
                               autocomplete="off"
                               autofocus />

                        <button id="searchBtn"
                                type="submit"
                                class="fut-search-btn">

                            <i class="fa-solid fa-magnifying-glass"></i>
                            <span>Search</span>

                        </button>


                    </div>

                    <!-- Existing Suggestions -->
                    <div id="suggestions"
                         class="search-suggestions"></div>

                    <!-- Validation -->
                    <div class="msgerror alert alert-danger d-none mt-2"
                         role="alert"></div>

                </div>

            </form>

            <!-- Search Hints -->
            <div class="intel-search-hints">

                <span class="intel-hints-title">
                    <i class="fa-solid fa-circle-info"></i>
                    Search smarter:
                </span>

                <span class="intel-hint">
                    <i class="fa-solid fa-font"></i>
                    Keyword Search
                </span>

                <span class="intel-hint">
                    <i class="fa-solid fa-quote-left"></i>
                    Exact Phrases
                </span>

                <span class="intel-hint">
                    <i class="fa-solid fa-brain"></i>
                    AI Similarity
                </span>

            </div>

        </div>

    </section>

    <!-- Dashboard Cards -->
    <section class="intel-dashboard-section">

        <div class="intel-section-header">

            <div>
                <h2>Overview</h2>
                <p>Your search workspace at a glance</p>
            </div>

            <div class="intel-section-indicator">
                <i class="fa-solid fa-chart-simple"></i>
                Dashboard
            </div>

        </div>

        <div class="intel-cards-grid">

            <!-- Card 1: Quick Stats -->
            <article class="intel-card">

                <div class="intel-card-header">

                    <div class="intel-card-icon blue">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <span class="intel-card-category">
                        Repository
                    </span>

                </div>

                <h3>Quick Statistics</h3>

                <p class="intel-card-description">
                    Overview of indexed documents and crawled sources.
                </p>

                <div class="intel-card-data">

                    <div class="intel-stat-row">

                        <div class="intel-stat-label">
                            <i class="fa-regular fa-file-lines"></i>
                            Indexed Documents
                        </div>

                        <span id="totalDocuments"
                              class="intel-stat-value">
                            Loading...
                        </span>

                    </div>

                    <div class="intel-stat-row">

                        <div class="intel-stat-label">
                            <i class="fa-solid fa-globe"></i>
                            Crawled Websites
                        </div>

                        <span id="totalScrapWeb"
                              class="intel-stat-value">
                            Loading...
                        </span>

                    </div>

                </div>

            </article>

            <!-- Card 2: Recent Activity -->
            <article class="intel-card">

                <div class="intel-card-header">

                    <div class="intel-card-icon purple">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>

                    <span class="intel-card-category">
                        Activity
                    </span>

                </div>

                <h3>Recent Activity</h3>

                <p class="intel-card-description">
                    View your latest search activity and interactions.
                </p>

                <div class="intel-card-data">

                    <div class="intel-activity-row">

                        <div class="intel-activity-icon">
                            <i class="fa-regular fa-clock"></i>
                        </div>

                        <div class="intel-activity-content">
                            <span class="intel-data-label">
                                Last Search
                            </span>
                            <span class="spnlastsearchdate intel-data-text">
                                No recent activity
                            </span>
                        </div>

                    </div>

                    <div class="intel-activity-row">

                        <div class="intel-activity-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>

                        <div class="intel-activity-content">
                            <span class="intel-data-label">
                                Recent Query
                            </span>
                            <span class="spnRecentSearches intel-data-text">
                                No searches yet
                            </span>
                        </div>

                    </div>

                </div>

            </article>

            <!-- Card 3: Search Tips -->
            <article class="intel-card">

                <div class="intel-card-header">

                    <div class="intel-card-icon amber">
                        <i class="fa-regular fa-lightbulb"></i>
                    </div>

                    <span class="intel-card-category">
                        Guide
                    </span>

                </div>

                <h3>Search Tips</h3>

                <p class="intel-card-description">
                    Simple techniques to improve search accuracy.
                </p>

                <div class="intel-card-data">

                    <div class="intel-tip-row">
                        <div class="intel-tip-icon">
                            <i class="fa-solid fa-quote-left"></i>
                        </div>
                        <div>
                            <strong>Exact Phrase</strong>
                            <span>Use "double quotes" for exact text.</span>
                        </div>
                    </div>

                    <div class="intel-tip-row">
                        <div class="intel-tip-icon">
                            <i class="fa-solid fa-brain"></i>
                        </div>
                        <div>
                            <strong>AI Similarity</strong>
                            <span>Use (parentheses) for semantic search.</span>
                        </div>
                    </div>

                </div>

            </article>

        </div>

    </section>

</main>

<!-- Existing PDF Upload Modal -->
@await Html.PartialAsync("_Upload")

<script src="~/devjs/dashboard.js"></script>