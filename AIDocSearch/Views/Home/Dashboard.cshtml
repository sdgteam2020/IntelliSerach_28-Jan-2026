@*
    Futuristic Dashboard with Hero Search and Glassmorphism Cards
*@
@{
    ViewData["Title"] = "Dashboard";
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest";
}

<link href="~/css/search.css" rel="stylesheet" />
<link href="~/css/dashboard.css" rel="stylesheet" />

<!-- Hero Section with Centered Search -->
<div class="container mt-2">
<div class="fut-hero">
    <div class="fut-hero-content">
        <!-- Logo -->
        <img src="~/images/logo.png"
             alt="Indian Army IntelliSearch Logo"
             class="fut-logo " />

        <!-- Title -->
        <h1 class="fut-title  d-none">
            Indian Army IntelliSearch
        </h1>

        <!-- Subtitle -->
        <h2 class="fut-subtitle d-none">
            Your Smart Document Exploration and Search Engine
        </h2>

        <!-- Search Form -->
        <form id="searchForm"
              method="post"
              action="~/Search/Index"
              class="fut-search-form"
              role="search">

            <div class="fut-search-wrapper">
                <img src="~/images/Search.png"
                     alt=""
                     class="fut-search-icon"
                     aria-hidden="true" />

                <input type="text"
                       id="searchInput"
                       name="searchInput"
                       class="fut-search-input"
                       placeholder='Search text, "exact phrase", or (AI Similar Search)...'
                       aria-label="Search"
                       autofocus
                       autocomplete="off"
                      @*  pattern='(?:[A-Za-z0-9 ]+|"[A-Za-z0-9 ]+"|\([A-Za-z0-9 ]+\))?'
                       title='Only letters, numbers and spaces are allowed. You may also use "quotes" or (parentheses). The field can be blank.' *@ />
                <button id="searchBtn"
                        class="fut-search-btn"
                        type="submit">
                    <i class="fas fa-search" aria-hidden="true"></i> Search
                </button>
                <span class="msgerror alert alert-danger m-lg-1 d-none"></span>
            </div>
            
            <div id="suggestions"></div>
           
        </form>
    </div>

    <!-- Cards Section -->
    <div class="fut-cards-section">
        <div class="fut-cards-row">

            <!-- Card 1: Quick Stats -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="fut-card-title">Quick Stats</h3>
                <p class="fut-card-text">
                    Access powerful analytics and insights from your document repository.
                </p>
                <ul class="fut-card-list">
                    <li>
                        <i class="fas fa-file-alt"></i>
                        Total Indexed Docs: <span id="totalDocuments">Loading...</span>
                    </li>

                    <li>
                        <i class="fas fa-database"></i>
                        Total Crawled Website: <span id="totalScrapWeb">Loading...</span>
                    </li>
                </ul>
            </div>

            <!-- Card 2: Recent Activity -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-history"></i>
                </div>
                <h3 class="fut-card-title">Recent Activity</h3>
                <p class="fut-card-text">
                    Track your latest searches and document interactions.
                </p>
                <ul class="fut-card-list">
                    <li><i class="fas fa-clock"></i> Last search: <span class="spnlastsearchdate"></span></li>
                    <li><i class="fas fa-search"></i> Recent Search: <span class="spnRecentSearches"></span></li>
                </ul>
            </div>

            <!-- Card 3: Quick Tips -->
            <div class="fut-card">
                <div class="fut-card-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3 class="fut-card-title">Quick Tips</h3>
                <p class="fut-card-text">
                    Enhance your search experience with these pro tips.
                </p>
                <ul class="fut-card-list">
                    <li><i class="fas fa-quote-left"></i> Use "quotes" for exact phrase search</li>
                    <li><i class="fas fa-circle-nodes"></i> Use (parentheses) for AI Similar Search</li>
                </ul>
            </div>

        </div>
    </div>

</div>
</div>
<script src="~/devjs/dashboard.js"></script>

