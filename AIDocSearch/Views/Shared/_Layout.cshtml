@using AIDocSearch.Helpers
@using Domain.CommonModel
@using Domain.IdentityEntities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> signInManager;
@inject UserManager<ApplicationUser> userManager;
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration;
<html lang="en" class="light-theme">
<head>
  
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        (function () {
            try {
                const savedSize = Number(localStorage.getItem("intelFontSize"));
                const validSizes = [90, 100, 110, 120, 130];

                if (validSizes.includes(savedSize)) {
                    document.documentElement.style.fontSize = savedSize + "%";
                    document.documentElement.dataset.fontSize = savedSize;
                }
            } catch (error) {
                // Continue with the default document font size when storage is unavailable.
            }
        })();
    </script>
    <title>Indian Army IntelliSearch</title>
    <!--Bootstrap 4 CDN-->
    <link href="~/bootstrap/css/bootstrap.min.css" asp-append-version="true"  rel="stylesheet" />
    <link href="~/sweetalert2/sweetalert2.min.css" asp-append-version="true"  rel="stylesheet" />
    <link href="~/css/toastr.min.css" rel="stylesheet" />
    <!--Fontawesome CDN-->
    <link href="~/fontawesome/css/all.min.css" asp-append-version="true"  rel="stylesheet" />

    <link href="~/css/site.css" asp-append-version="true"  rel="stylesheet" />
    <link href="~/css/futuristic.css" asp-append-version="true"  rel="stylesheet" />
    <script src="~/js/crypto-js.min.js" asp-append-version="true" defer></script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/js/toastr.js"></script>
</head>
<body>

    <div id="loading" class="loader">
        <div class="loader-container">
            <div class="loader-spinner"></div>

            <h4 class="loadertext">Loading...</h4>
            <span>Please wait while we process your request.</span>
        </div>
    </div>
  
    @{
        DTOSession? dtoSession = new DTOSession();
        if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("Users")))
        {
            dtoSession = SessionHeplers.GetObject<DTOSession>(HttpContextAccessor.HttpContext.Session, "Users");

        }
     }
    @Html.AntiForgeryToken()
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

            bool isAdmin = User.IsInRole("Admin");
            bool isAuthenticated = User.Identity?.IsAuthenticated == true;
        }
        <nav class="navbar navbar-expand-xl intel-navbar custom-navbar">

            <div class="container-fluid intel-nav-container">

                <!-- LOGO -->
                <a class="navbar-brand intel-navbar-brand"
                   asp-controller="Home"
                   asp-action="Dashboard">

                    <img src="~/images/logo.png"
                         alt="Indian Army IntelliSearch"
                         class="intel-navbar-logo" />

                    <div class="intel-navbar-brand-text">
                        <span class="intel-brand-name">IntelliSearch</span>
                        <small>Document Discovery</small>
                    </div>

                </a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler intel-nav-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#intelNavbarMenu"
                        aria-controls="intelNavbarMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="intelNavbarMenu">

                    <!-- NAVIGATION LINKS -->
                    <ul class="navbar-nav intel-nav-links">

                        <li class="nav-item">
                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="nav-link @(currentController == "Home" && currentAction == "Dashboard" ? "active" : "")">

                                <i class="fa-solid fa-house"></i>
                                <span>Home</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Search"
                               asp-action="Upload"
                               class="nav-link @(currentController == "Search" && currentAction == "Upload" ? "active" : "")">

                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span>Upload</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="Index"
                               asp-action="IndexesDetails"
                               class="nav-link @(currentController == "Index" ? "active" : "")">

                                <i class="fa-solid fa-database"></i>
                                <span>Indexes</span>

                            </a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a asp-controller="Scraper"
                                   asp-action="Index"
                                   class="nav-link @(currentController == "Scraper" ? "active" : "")">

                                    <i class="fa-solid fa-spider"></i>
                                    <span>Crawler</span>

                                </a>
                            </li>

                            <!-- ADMIN MANAGEMENT DROPDOWN -->
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle @(currentController == "Master" || (currentController == "Account" && currentAction == "RegistrationRequest") ? "active" : "")"
                                   href="#"
                                   id="intelManageDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="fa-solid fa-gears"></i>
                                    <span>Management</span>

                                </a>

                                <ul class="dropdown-menu intel-nav-dropdown"
                                    aria-labelledby="intelManageDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Master"
                                           asp-action="AddWebScraperSetting">

                                            <i class="fa-solid fa-sliders"></i>
                                            Crawler Page Limit
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Master"
                                           asp-action="AddIndexer">

                                            <i class="fa-solid fa-circle-plus"></i>
                                            Add Indexer
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="RegistrationRequest">

                                            <i class="fa-solid fa-user-check"></i>
                                            User Requests
                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }

                    </ul>
                    <!-- FONT SIZE CONTROLS -->
                    <div class="intel-font-controls" role="group" aria-label="Font size controls">

                        <button type="button"
                                id="fontDecrease"
                                class="intel-font-btn"
                                title="Decrease font size"
                                aria-label="Decrease font size"
                                aria-pressed="false">
                            A<sup>−</sup>
                        </button>

                        <button type="button"
                                id="fontReset"
                                class="intel-font-btn"
                                title="Reset font size"
                                aria-label="Reset font size"
                                aria-pressed="false">
                            A
                        </button>

                        <button type="button"
                                id="fontIncrease"
                                class="intel-font-btn"
                                title="Increase font size"
                                aria-label="Increase font size"
                                aria-pressed="false">
                            A<sup>+</sup>
                        </button>

                    </div>
                    <!-- RIGHT SIDE -->
                    <div class="intel-navbar-right">

                        <!-- THEME TOGGLE -->
                        <button id="themeToggle"
                                type="button"
                                class="intel-theme-btn"
                                aria-pressed="false"
                                aria-label="Toggle theme"
                                title="Toggle theme">

                            <i class="fas fa-moon" aria-hidden="true"></i>

                        </button>

                        @if (isAuthenticated)
                        {
                            <!-- USER ACCOUNT -->
                            <div class="dropdown intel-account-dropdown">

                                <button type="button"
                                        class="intel-user-btn dropdown-toggle"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span class="intel-user-avatar">
                                        <i class="fa-solid fa-user"></i>
                                    </span>

                                    <span class="intel-user-information">
                                        <span class="intel-user-name">
                                            @dtoSession.RankName @dtoSession.Name
                                        </span>

                                        <small class="intel-user-role">
                                            @dtoSession.RoleName
                                        </small>
                                    </span>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end intel-nav-dropdown intel-account-menu">

                                    <li class="intel-account-header">

                                        <strong>
                                            @dtoSession.RankName @dtoSession.Name
                                        </strong>

                                        <small>@dtoSession.RoleName</small>
                                        <input type="hidden" id="payloadaes" value="@dtoSession.AESKey" />
                                        <input type="hidden" id="spnUserName" value="@dtoSession.UserName" />
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item intel-logout-item">

                                                <i class="fa-solid fa-right-from-bracket"></i>
                                                Logout

                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </div>

                            <input type="hidden"
                                   id="spnUserName"
                                   value="@dtoSession.UserName" />
                        }

                    </div>

                </div>

            </div>

        </nav>
    </header>
   
    <div class="container container-Bottom-Margin">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    
        <footer class="border-top footer text-muted fixed-bottom bg-white">
            <div class="container text-center">
            <h3 class="ai-tagline">
                🚀 Unlock Knowledge with Indian Army IntelliSearch !
            </h3>

            </div>
        </footer>
    

    <!-- Ensure jQuery is loaded before Bootstrap JS -->
    
    <script src="~/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
    <script src="~/sweetalert2/sweetalert2.min.js" asp-append-version="true" defer></script>
    <script src="~/js/crypto-js.min.js" asp-append-version="true" defer></script>
    <script src="~/js/futuristic.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/devjs/loadaes.js" asp-append-version="true" defer></script>
   
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
