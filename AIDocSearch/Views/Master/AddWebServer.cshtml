@model Domain.DTOs.Requests.DTOAddWebServerRequest
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Web Server alias</h4>
                </div>

                <div class="card-body">
                    <form asp-controller="Master"
                          asp-action="AddWebServer"
                          method="post"
                          id="SaveForm"
                          enctype="multipart/form-data"
                          autocomplete="off">

                        @Html.AntiForgeryToken()
                        <input type="hidden" id="EncryptedData" name="EncryptedData" value="null" />
                        <div class="row align-items-end">
                            <input asp-for="Id" type="hidden" />
                            <div class="col-md-1">
                                <label asp-for="Url" class="form-label"></label>
                            </div>

                            <div class="col-md-2">
                                <input asp-for="Url" class="form-control" required />
                                <span asp-validation-for="Url" class="text-danger"></span>
                            </div>

                            <div class="col-md-1">
                                <label asp-for="Includes" class="form-label"></label>
                            </div>

                            <div class="col-md-2">
                                <input asp-for="Includes" class="form-control" required />
                                <span asp-validation-for="Includes" class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Index_Name" class="form-label"></label>
                            </div>

                            <div class="col-md-2">
                                <input asp-for="Index_Name" class="form-control" required />
                                <span asp-validation-for="Index_Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    Save
                                </button>
                            </div>

                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mt-3">
                                Please fix the errors. @TempData["ErrorMessage"]
                            </div>
                        }

                    </form>
                    @{
                        int srNo = 1;
                    }
                    <div class="container mt-3">
                        <div class="shadow-sm border-0">
                           
                            <div class="card-body p-0 table-responsive">
                                <table class="table table-hover mb-0 align-middle " id="tblData">
                                    <thead class="table-light">
                                        <tr>
                                        <tr>
                                            <th>Sr. No</th>
                                            <th>Url</th>
                                            <th>Path Pattern</th>
                                            <th>Index Name</th>
                                            <th>CreateOn</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                        <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/devjs/addwebserver.js"></script>