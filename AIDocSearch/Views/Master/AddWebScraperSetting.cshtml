@model Domain.DTOs.Requests.DTOWebScraperSettingRequest
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Web Crawler Setting</h4>
                </div>

                <div class="card-body">
                    <form asp-controller="Master"
                          asp-action="AddWebScraperSetting"
                          method="post"
                          enctype="multipart/form-data"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        <div class="row align-items-end">
                            <input asp-for="Id" type="hidden" />
                            <div class="col-md-2">
                                <label asp-for="max_pages" class="form-label"></label>
                            </div>

                            <div class="col-md-3">
                                <input asp-for="max_pages" class="form-control" required />
                                <span asp-validation-for="max_pages" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="max_pdfs" class="form-label"></label>
                            </div>

                            <div class="col-md-3">
                                <input asp-for="max_pdfs" class="form-control" required />
                                <span asp-validation-for="max_pdfs" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    Update
                                </button>
                            </div>

                        </div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mt-3">
                                <strong>Please fix the following errors:</strong>
                                <ul class="mb-0">
                                    @foreach (var error in ViewData.ModelState.Values
                                        .SelectMany(v => v.Errors))
                                    {
                                        <li>
                                            @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                                ? "Invalid value."
                                                : error.ErrorMessage)
                                        </li>
                                    }
                                </ul>
                            </div>
                        }


                    </form>
                    @{
                        int srNo = 1;
                    }
                    <div class="container mt-3">
                        <div class="card shadow-sm border-0">
                            

                            <div class="card-body p-0">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="slno-width">Sr. No</th>
                                            <th>max_pages</th>
                                            <th>max_pdfs</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ViewBag.AllData)
                                        {
                                            <tr>
                                                <td>@srNo</td>
                                                <td>
                                                    @item.max_pages
                                                </td>
                                                <td>
                                                    @item.max_pdfs
                                                </td>
                                                
                                                <td class="text-center">
                                                    <input type="button"
                                                           class="btn btn-primary btnEdit"
                                                           value="Edit"
                                                           data-id="@item.Id"
                                                           data-max_pages="@item.max_pages"
                                                           data-max_pdfs="@item.max_pdfs" />
                                                </td>
                                            </tr>
                                            srNo++;
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/devjs/webscrapersetting.js"></script>