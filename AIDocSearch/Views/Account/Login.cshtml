@model DataTransferObject.DTO.Requests.DTOLoginRequest


@{
    ViewData["Title"] = "Login Page";
    Layout = null;
}


<!DOCTYPE html>
<html>
<head>
    <title>Login Page</title>
   
    <link href="~/bootstrap/css/bootstrap.min.css" asp-append-version="true" rel="stylesheet" />

    <link href="~/fontawesome/css/all.min.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/login.css" asp-append-version="true" rel="stylesheet" />
    <script src="~/js/crypto-js.min.js" asp-append-version="true" defer></script>
</head>
<body>
    <canvas id="canvas"></canvas>

    <div class="container">
        <div class="d-flex justify-content-center h-100">
            <div class="card">
                <div class="card-header text-center">
                    <img src="~/images/logo.webp"
                         alt="Logo"
                         width="100"
                         height="100"
                         class="app-logo mx-auto d-block" />
                    <h3>Log in</h3>
                    @* <div class="d-flex justify-content-end social_icon">
                        <span><i class="fa-solid fa-file-pdf"></i></span>
                        <span><i class="fa-solid fa-file-word"></i></span>
                    </div> *@
                </div>
                <div class="card-body">
                    <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                        <input type="hidden" id="payloadaes" value="@ViewBag.hdns" />
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="UserName" class="visually-hidden"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-user"></i>
                                </span>
                                <input asp-for="UserName"
                                       class="form-control" value="@Model.UserName"
                                       required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="visually-hidden"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-key"></i>
                                </span>
                                <input asp-for="Password"
                                       class="form-control"
                                       required />
                            </div>
                        </div>
                     <div class="mb-3">
    <label asp-for="RoleName" class="visually-hidden">
        Role
    </label>

    <div class="input-group">
        <span class="input-group-text">
            <i class="fa-solid fa-user-tie"></i>
        </span>

        <select asp-for="RoleName" class="form-select" required>
            <option value="">Select Role</option>
            <option value="User">User</option>
            <option value="Admin">Admin</option>
        </select>
    </div>
</div>

<div class="d-grid">
    <button type="submit" class="btn btn-warning">
        Login
    </button>
</div>
                        <div class="alert  mt-2" role="alert">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div class="text-danger">@modelError.ErrorMessage</div>
                                }
                            }
                            <span asp-validation-for="UserName" class="text-danger"></span>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                            <div class="text-danger d-none" id="txterrormsg"></div>

                        </div>
                    </form>
                </div>

                @* <div class="card-footer">
					<div class="d-flex justify-content-center links">
						Don't have an account?<a href="#">Sign Up</a>
					</div>
					<div class="d-flex justify-content-center">
						<a href="#">Forgot your password?</a>
					</div>
				</div> *@
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/devjs/loadaes.js"></script>
<script src="~/devjs/login.js"></script>
