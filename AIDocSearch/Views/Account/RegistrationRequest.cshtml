@{
}
@model DataTransferObject.DTO.Requests.DTORegisterRequest

@{
    ViewData["Title"] = "Register";
}
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>User Register</h4>
                </div>
                <div class="card-body">
                    
                    <div class="table-responsive p-2">
                        <table class="table border border-purple " role="grid" id="tbldata">
                            <thead>
                                <tr>
                                    <th class="wd-40-f">SerialNumber</th>
                                    <th class="nowrap">Domain ID</th>
                                    <th class="nowrap">Role</th>
                                    <th class="nowrap">Name</th>
                                    <th class="noExport nowrap">Action</th>
                                </tr>
                            </thead>
                            <tbody id="DetailBody">
                            </tbody>
                        </table>

                    </div>
                </div>
               
              
            </div>
        </div>
    </div>
</div>

<script src="~/devjs/registrationrequest.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
