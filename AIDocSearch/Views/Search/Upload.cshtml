@using AIDocSearch.Helpers
@using Application.Interfaces
@using Domain.CommonModel
@model Domain.DTOs.Requests.DTOUploadRequest
@inject IAESEncrytDecry _iAESEncrytDecry;
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration;

@{
    DTOSession? dtoSession = new DTOSession();
    if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("Users")))
    {
        dtoSession = SessionHeplers.GetObject<DTOSession>(HttpContextAccessor.HttpContext.Session, "Users");

    }
}
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Upload PDF File For Indexing</h4>
                </div>

                <div class="card-body">
                    <form asp-controller="Search"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data"
                          autocomplete="off">

                        @Html.AntiForgeryToken()

                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <label class="fw-bold">Upload (PDF)</label>
                            </div>

                            <div class="col-md-5">
                                <input asp-for="FileName" required
                                       type="file"
                                       class="form-control"
                                       accept=".pdf" />

                                <span asp-validation-for="FileName" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-upload"></i> Upload
                                </button>
                            </div>
                        </div>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fa fa-check-circle"></i>
                                @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert">X</button>
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fa fa-exclamation-triangle"></i>
                                Please fix the errors below.
                                <ul class="mb-0 mt-2">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                    </form>
                    @{
                        int srNo = 1;
                    }
                    <div class="container mt-3">
                        <div class=" shadow-sm border-0">
                           
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0 align-middle" id="tblData">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sr. No</th>
                                            <th>File Name</th>
                                            <th>Created On</th>
                                            <th class="text-center">View</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                        @foreach (var item in ViewBag.AllData)
                        {
                                            var pdfUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/UploadForIndexing/{item.FileName}";
                                            pdfUrl = _iAESEncrytDecry.EncryptAES(pdfUrl, dtoSession.AESKey);
                                            <tr>
                                                <td>@srNo</td>
                                                <td>
                                                    <i class="fa fa-file-pdf-o text-danger me-2"></i>
                                                    <a href="@Url.Action("WatermarkPdfFromUrl", "Master", new { pdfUrl = Uri.EscapeDataString(pdfUrl) })"
                                                       class="text-decoration-none fw-semibold"
                                                       target="_blank">
                                                       
                                                        @item.OrignalFileName


                                                    </a>
                                                </td>
                                                <td>
                                                    @item.CreatedOn.ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td class="text-center">
                                                    <a href="@Url.Action("WatermarkPdfFromUrl", "Master", new { pdfUrl = Uri.EscapeDataString(pdfUrl) })"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="View PDF"
                                                       target="_blank">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-danger btnDel"
                                                            data-id="@item.TrnUploadId">
                                                        <i class="fa-solid fa-trash"></i> 
                                                    </button>
                                                </td>
                                            </tr>
                                            srNo++;
                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/devjs/upload.js"></script>