@using AIDocSearch.Helpers
@using Application.Interfaces
@using Domain.CommonModel
@model Domain.DTOs.Requests.DTOUploadRequest
@inject IAESEncrytDecry _iAESEncrytDecry;
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration;

@{
    DTOSession? dtoSession = new DTOSession();
    if (!string.IsNullOrEmpty(@HttpContextAccessor.HttpContext.Session.GetString("Users")))
    {
        dtoSession = SessionHeplers.GetObject<DTOSession>(HttpContextAccessor.HttpContext.Session, "Users");

    }
}
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Upload PDF File For Indexing</h4>
                </div>

                <div class="card-body">
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#uploadPdfModal">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        Upload PDF
                    </button>
                    @{
                        int srNo = 1;
                    }
                    <div class="container mt-3">
                        <div class=" shadow-sm border-0">
                           
                            <div class="card-body p-0">

                                <table class="table table-bordered table-striped align-middle" id="tblData">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="slno-width">Sr. No</th>
                                            <th>File Name</th>
                                            <th>Created On</th>
                                            <th class="text-center">View</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        
                        @foreach (var item in ViewBag.AllData)
                        {
                                            var fileNameUrl = item.FileName.Replace('\\', '/'); 
                                            var pdfUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/IntelliSearch/UploadForIndexing/{fileNameUrl}";
                                            pdfUrl = _iAESEncrytDecry.EncryptAES(pdfUrl, dtoSession.AESKey);
                                            <tr>
                                                <td>@srNo</td>
                                                <td>
                                                    <i class="fa fa-file-pdf-o text-danger me-2"></i>
                                                    <a href="@Url.Action("WatermarkPdfFromUrl", "Master", new { pdfUrl = Uri.EscapeDataString(pdfUrl) })"
                                                       class="text-decoration-none fw-semibold"
                                                       target="_blank">
                                                       
                                                        @item.OrignalFileName


                                                    </a>
                                                </td>
                                                <td>
                                                    @item.CreatedOn.ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td class="text-center">
                                                    <a href="@Url.Action("WatermarkPdfFromUrl", "Master", new { pdfUrl = Uri.EscapeDataString(pdfUrl) })"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="View PDF"
                                                       target="_blank">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-danger btnDel"
                                                            data-id="@item.TrnUploadId">
                                                        <i class="fa-solid fa-trash"></i> 
                                                    </button>
                                                </td>
                                            </tr>
                                            srNo++;
                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_Upload")
<script src="~/devjs/upload.js"></script>
