@model IEnumerable<Domain.DTOs.Response.DTOIndexesDetailsResponse>

@{
    ViewData["Title"] = "Elasticsearch Index Details";
}
@await Html.PartialAsync("_datatable", Model)

<div class="container mt-1">

    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Indexes Details</h4>
                </div>
                <div class="card-body">
                   
                    <table class="table table-hover mb-0 align-middle" id="tblData">
                            <thead class="table-light">
                            <tr>
                                <th>Health</th>
                                <th>Index</th>
                                <th>Docs Count</th>
                                <th>Docs Deleted</th>
                                <th>Store Size</th>
                              @*   <th>Primary Store Size</th>
                                <th>Dataset Size</th> *@
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="health-@item.health.ToLower()">
                                                @item.health.ToUpper()
                                            </span>
                                        </td>
                                        <td>@item.index.Replace("seo_", "")</td>
                                        <td>@item.DocsCount</td>
                                        <td>@item.DocsDeleted</td>
                                        <td>@item.StoreSize</td>
                                       @*  <td>@item.PriStoreSize</td>
                                        <td>@item.DatasetSize</td> *@
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-danger">
                                        No Index Data Found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/devjs/indexesdetails.js"></script>