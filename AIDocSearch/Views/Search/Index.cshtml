@{
    ViewData["Title"] = "IntelliSearch";
}

<link href="~/css/search.css" rel="stylesheet" />

<div class="is-page">

    <div class="is-workspace">

        <!-- Index Filters -->
        <section class="is-index-panel">
            <ul class="mainfilters filters"
                id="mainFilters">
            </ul>
        </section>

        <!-- Search Area -->
        <section class="is-search-panel">

            <div class="is-search-bar">

                <button type="button"
                        class="is-upload-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#uploadPdfModal"
                        title="Upload PDF to Searchable Index"
                        aria-label="Upload PDF">
                    <i class="fa-solid fa-plus"></i>
                </button>
                <input type="text"
                       id="searchInput"
                       name="searchInput"
                       value="@ViewBag.query"
                       class="is-search-input"
                       placeholder="Search documents, keywords or phrases..."
                       aria-label="Search documents"
                       autofocus
                       autocomplete="off" />

                <div id="suggestions"
                     class="search-suggestions"></div>

                <button type="button"
                        id="btnSearch"
                        class="is-search-btn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Search</span>
                </button>

               

            </div>

            <div class="msgerror alert alert-danger d-none mt-2"
                 role="alert"></div>

            <!-- Compact Search Mode -->
            <div class="is-search-options">

                <div class="is-mode-label">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Search Mode</span>
                </div>

                <ul class="filters secondfilters">

                    <li class="filter secondfilter active"
                        data-secondfilters="1"
                        title="Keyword or Phrase Search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Keyword or Phrase Search</span>
                    </li>

                    <li class="filter secondfilter"
                        data-secondfilters="2"
                        title="AI Similar Search">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>AI Similar Search</span>
                    </li>

                    <li class="filter secondfilter"
                        data-secondfilters="3"
                        title="Exact Match Search">
                        <i class="fa-solid fa-quote-left"></i>
                        <span>Exact Match Search</span>
                    </li>

                </ul>

            </div>

        </section>

        <!-- Results Header -->
        <section class="is-results-toolbar">

            <div class="is-results-info">

                <div class="is-results-title">
                    <i class="fa-solid fa-list-ul"></i>
                    <span>Search Results</span>
                </div>

                <div id="CountSearch"
                     class="is-count-info d-none">

                    <span id="resultCount"></span>

                    <span class="is-toolbar-divider"></span>

                    <i class="fa-regular fa-clock"></i>

                    <span id="resultTime"></span>

                </div>

            </div>

            <div id="paginationTop"
                 class="pagination"></div>

        </section>

        <!-- AJAX Search Results -->
        <section class="is-results-panel">
            <div id="results"></div>
        </section>

        <!-- Bottom Pagination -->
        <div class="is-bottom-pagination">
            <div id="paginationBottom"
                 class="pagination"></div>
        </div>

    </div>

</div>

@await Html.PartialAsync("_Upload")

<script src="~/devjs/search.js"></script>