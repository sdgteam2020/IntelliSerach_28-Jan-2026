@model Domain.DTOs.Requests.DTOScraperRequest
@{
    ViewData["Title"] = "Crawler";
}

<link href="~/css/scraper.css" rel="stylesheet" />
@await Html.PartialAsync("_datatable", Model)
<div class="container mt-1">
   
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Crawler</h4>
                </div>
                <div class="card-body">
                     <form id="ScraperForm" class=" align-items-center gap-3">
                       
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            @Html.AntiForgeryToken()
                            <div class="row">
                           

                            <div class="row align-items-center mb-3 ">
                        <div class="col-md-2">
                            <label asp-for="Url" class="col-form-label"></label>
                        </div>

                        <div class="col-md-4">
                                    <input asp-for="Url" class="form-control" value="https://192.168.10.40" required />
                            <span asp-validation-for="Url" class="text-danger"></span>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Abbreviation" class="col-form-label"></label>
                        </div>

                        <div class="col-md-2">
                                    <input asp-for="Abbreviation" class="form-control" value="mou_1" required />
                            <span asp-validation-for="Abbreviation" class="text-danger"></span>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100" id="btnsave">
                             Go Crawler
                            </button>
                        </div>
                    </div>

                           
                            </div>

                           
                            
                        
                    </form>

                    <div class="container mt-4 webviewcontainer">

                      
                        <!-- Table -->
                      
                
<div class="card shadow-sm ">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
                <i class="fa fa-globe me-2"></i>
                                        Web Crawlering Jobs
            </h5>
            <small class="text-muted">
                                        Crawler crawl job information
            </small>
        </div>

                                <span id="crawl_status"
                                      class="badge fs-5 px-4 py-2">
                                    Waiting
                                </span>
                                

    </div>

                      
                            <div class="card-body">

                                <!-- Crawl Summary -->
                                <div class="row g-3">

                                    <!-- Website URL -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-globe me-1"></i>
                                                Website URL
                                            </small>

                                            <div class="fw-semibold text-break" id="websitewebUrl">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Status -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-info-circle me-1"></i>
                                                Status
                                            </small>

                                            <div id="crawl_status_div">
                                                <span class="badge bg-secondary">
                                                    Waiting
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Job ID -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-tasks me-1"></i>
                                                Job ID
                                            </small>

                                            <div class="fw-semibold text-break" id="job_id">
                                              -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Alias -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-tag me-1"></i>
                                                Alias
                                            </small>

                                            <div class="fw-semibold text-break" id="alias">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Index Name -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-database me-1"></i>
                                                Index Name
                                            </small>

                                            <div class="fw-semibold text-break" id="index_name">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Deleted Documents -->
                                    <div class="col-md-4">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-trash me-1"></i>
                                                Deleted Existing Documents
                                            </small>

                                            <div class="fw-semibold" id="deleted_existing_docs">
                                                0
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Registry Reused -->
                                    <div class="col-md-4 d-none">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                Registry Reused
                                            </small>

                                            <div id="registry_reused">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Continue From Last -->
                                    <div class="col-md-4 d-none">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                Continue From Last
                                            </small>

                                            <div id="continue_from_last">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Recovery Resumed -->
                                    <div class="col-md-4 d-none">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                Recovery Resumed
                                            </small>

                                            <div id="recovery_resumed">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Purge Applied -->
                                    <div class="col-md-4 d-none">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                Purge Applied
                                            </small>

                                            <div id="purge_applied">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Message -->
                                    <div class="col-md-6">
                                        <div class="border rounded p-2">
                                            <small class="text-muted d-block mb-1">
                                                <i class="fa fa-comment me-1"></i>
                                                Message
                                            </small>

                                            <div class="fw-semibold text-break" id="scraping_message">
                                                -
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="col-4">
                                        <div class="border rounded p-3">
                                         @*    <small class="text-muted d-block mb-2">
                                                <i class="fa fa-link me-1"></i>
                                                Actions
                                            </small> *@

                                            <button type="button" id="btn_view_pdfs" class="btn btn-outline-danger w-100 d-none" > 
                                                <i class="fa fa-file-pdf me-1"></i>View All Crawled PDFs
                                            </button>
                                           
                               
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-start">

                                        <div class="mb-3 d-none">
                                            <strong>Status:</strong>
                                            <span id="popup_crawl_status"
                                                  class="badge bg-primary">
                                                Running
                                            </span>
                                        </div>

                                    <div class="mb-2  d-none">
                                            <strong>Job ID:</strong>
                                            <div id="popup_job_id"
                                                 class="text-muted text-break">
                                                -
                                            </div>
                                        </div>

                                        <hr>

                                        <div class="row g-2 text-center">

                                            <div class="col-4 d-none">
                                                <div class="border rounded p-2">
                                                    <small class="text-muted d-block">
                                                        Pages
                                                    </small>
                                                    <strong id="popup_pages_crawled">
                                                        0
                                                    </strong>
                                                </div>
                                            </div>

                                            <div class="col-4">
                                                <div class="border rounded p-2">
                                                    <small class="text-muted d-block">
                                                        Indexed
                                                    </small>
                                                    <strong id="popup_docs_indexed">
                                                        0
                                                    </strong>
                                                </div>
                                            </div>

                                            <div class="col-4">
                                                <div class="border rounded p-2">
                                                    <small class="text-muted d-block">
                                                        Links
                                                    </small>
                                                    <strong id="popup_links_found">
                                                        0
                                                    </strong>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="mt-3">
                                            <strong>Errors:</strong>
                                            <span id="popup_errors"
                                              class="badge bg-secondary" role="button">
                                               0
                                            </span>
                                        </div>

                                        <div class="mt-3">
                                            <strong>Message:</strong>
                                            <div id="popup_message"
                                                 class="text-muted text-break">
                                                Waiting crawl...
                                            </div>
                                        </div>

                                        <div class="mt-3 text-center d-none"
                                             id="popup_loading">

                                            <i class="fa fa-spinner fa-spin me-2"></i>
                                            Checking final status...

                                        </div>

                                    </div>

                                </div>

                            </div>
                            

</div>


                        

                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="modal fade" id="crawlErrorsModal" tabindex="-1"
     aria-labelledby="crawlErrorsTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content errors-modal">
            <div class="modal-header errors-header">
                <div>
                    <h5 class="modal-title" id="crawlErrorsTitle">
                        Crawl Error Records
                    </h5>
                    <small>Review URLs and crawl failure details</small>
                </div>

                <button type="button" id="closeCrawlErrors"
                        class="btn btn-light btn-sm" aria-label="Close">
                    Close
                </button>
            </div>

            <div class="modal-body">
                <div class="errors-summary">
                    <div>
                        <span class="errors-label">JOB ID</span>
                        <span id="errorJobId" class="errors-job"></span>
                    </div>
                    <div class="errors-total">
                        <span id="errorRecordCount">0</span>
                        <small>Total Errors</small>
                    </div>
                </div>

                <div class="errors-toolbar">
                    <div class="errors-search">
                        <label for="errorSearch">Search errors</label>
                        <input type="search" id="errorSearch"
                               class="form-control"
                               placeholder="Search URL, reason or details">
                    </div>

                    <div>
                        <label for="errorPageSize">Records per page</label>
                        <select id="errorPageSize" class="form-control">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>

                <div id="errorStatus" role="status"
                     aria-live="polite" class="mb-3"></div>

                <div id="crawlErrorsBody"></div>
            </div>

            <div class="modal-footer errors-footer">
                <span id="errorPageInfo" aria-live="polite"></span>
                <nav id="errorPagination" aria-label="Error record pages"></nav>
            </div>
        </div>
    </div>
</div>

<script src="~/devjs/scraper.js"></script>
<script src="~/devjs/scraper.error.js"></script>